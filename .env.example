# WohnungAgent Service Configuration
# Copy this file to .env and edit with your service credentials

# Service Email (Used for sending applications when the form option is not available)
# This is a central service account for your deployment, not for individual users
EMAIL_ADDRESS=your_service_email@example.com
EMAIL_PASSWORD=your_service_email_password
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_SMTP_PORT=587

# Database Configuration (Optional - defaults to SQLite)
# DATABASE_URL=sqlite:///database/wohnungen.db

# Scraper Configuration (Optional)
# HEADLESS=True  # Set to False for debugging
# TIMEOUT=30     # Seconds to wait for page loads 